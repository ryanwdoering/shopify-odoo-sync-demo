<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopify_sync_instance_list" model="ir.ui.view">
        <field name="name">shopify.sync.instance.list</field>
        <field name="model">shopify.sync.instance</field>
        <field name="arch" type="xml">
            <list string="Shopify Sync">
                <field name="name"/>
                <field name="shop_domain"/>
                <field name="last_connection_status" widget="badge"
                       decoration-success="last_connection_status == 'ok'"
                       decoration-danger="last_connection_status == 'failed'"/>
                <field name="product_count"/>
                <field name="published_product_count"/>
                <field name="order_count"/>
                <field name="failed_order_count"/>
                <field name="last_synced_at"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_sync_instance_form" model="ir.ui.view">
        <field name="name">shopify.sync.instance.form</field>
        <field name="model">shopify.sync.instance</field>
        <field name="arch" type="xml">
            <form string="Shopify Sync">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-secondary"/>
                    <button name="action_refresh_catalog" string="Refresh Inventory Catalog" type="object" class="btn-secondary"/>
                    <button name="action_publish_products" string="Publish Products" type="object" class="btn-primary"/>
                    <button name="action_publish_inventory" string="Publish Inventory" type="object" class="btn-primary"/>
                    <button name="action_publish_all" string="Publish All" type="object" class="btn-primary"/>
                    <button name="action_pull_orders" string="Pull Shopify Orders" type="object" class="btn-primary"/>
                    <button name="action_register_orders_create_webhook" string="Register Order Webhook" type="object" class="btn-secondary"
                            groups="base.group_system"/>
                    <button name="action_confirm_new_quotations" string="Confirm Quotations" type="object" class="btn-primary"/>
                    <button name="action_seed_demo_data" string="Seed Demo Data" type="object" class="btn-secondary"
                            groups="base.group_system"/>
                    <button name="action_reset_and_seed_demo_data" string="Reset Demo Data" type="object" class="btn-secondary"
                            groups="base.group_system"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_catalog" type="object" class="oe_stat_button" icon="fa-tags">
                            <field name="product_count" widget="statinfo" string="Catalog"/>
                        </button>
                        <button name="action_open_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_open_events" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="event_count" widget="statinfo" string="Events"/>
                        </button>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="name"/>
                            <field name="active"/>
                            <field name="shop_domain"/>
                            <field name="api_version"/>
                            <field name="auto_confirm_quotations"/>
                            <field name="last_connection_status" widget="badge"/>
                            <field name="last_synced_at"/>
                            <field name="last_webhook_at"/>
                        </group>
                        <group string="Credentials" groups="base.group_system">
                            <field name="access_token" password="True"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="webhook_secret" password="True"/>
                            <field name="webhook_callback_url"/>
                            <field name="orders_create_webhook_gid"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Catalog">
                            <field name="mapping_ids" readonly="1">
                                <list>
                                    <field name="sku"/>
                                    <field name="product_template_id"/>
                                    <field name="list_price"/>
                                    <field name="qty_available"/>
                                    <field name="available_to_sell"/>
                                    <field name="product_status" widget="badge"
                                           decoration-success="product_status == 'published'"
                                           decoration-danger="product_status == 'failed'"/>
                                    <field name="inventory_status" widget="badge"
                                           decoration-success="inventory_status == 'published'"
                                           decoration-danger="inventory_status == 'failed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Orders">
                            <field name="order_ids" readonly="1">
                                <list>
                                    <field name="order_number"/>
                                    <field name="customer_name"/>
                                    <field name="total_amount"/>
                                    <field name="financial_status"/>
                                    <field name="fulfillment_status"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status in ['validated', 'published', 'confirmed', 'paid', 'fulfilled']"
                                           decoration-warning="status == 'warning'"
                                           decoration-danger="status == 'failed'"/>
                                    <field name="sale_order_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Events">
                            <field name="event_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="action"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-warning="status == 'warning'"
                                           decoration-danger="status == 'failed'"/>
                                    <field name="message"/>
                                </list>
                    </field>
                </page>
            </notebook>
        </sheet>
    </form>
        </field>
    </record>

    <record id="view_shopify_sync_mapping_list" model="ir.ui.view">
        <field name="name">shopify.sync.product.mapping.list</field>
        <field name="model">shopify.sync.product.mapping</field>
        <field name="arch" type="xml">
            <list string="Shopify Catalog">
                <header>
                    <button name="action_publish_product" string="Publish Product" type="object"/>
                    <button name="action_publish_inventory" string="Publish Inventory" type="object"/>
                </header>
                <field name="sku"/>
                <field name="product_template_id"/>
                <field name="list_price"/>
                <field name="qty_available"/>
                <field name="available_to_sell"/>
                <field name="shopify_product_gid" optional="hide"/>
                <field name="shopify_variant_gid" optional="hide"/>
                <field name="shopify_inventory_item_gid" optional="hide"/>
                <field name="product_status" widget="badge"
                       decoration-success="product_status == 'published'"
                       decoration-danger="product_status == 'failed'"/>
                <field name="inventory_status" widget="badge"
                       decoration-success="inventory_status == 'published'"
                       decoration-danger="inventory_status == 'failed'"/>
                <field name="last_product_published_at"/>
                <field name="last_inventory_published_at"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_sync_mapping_form" model="ir.ui.view">
        <field name="name">shopify.sync.product.mapping.form</field>
        <field name="model">shopify.sync.product.mapping</field>
        <field name="arch" type="xml">
            <form string="Shopify Catalog Mapping">
                <header>
                    <button name="action_publish_product" string="Publish Product" type="object" class="btn-primary"/>
                    <button name="action_publish_inventory" string="Publish Inventory" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="product_template_id"/>
                            <field name="product_variant_id"/>
                            <field name="sku"/>
                            <field name="list_price"/>
                            <field name="qty_available"/>
                            <field name="available_to_sell"/>
                        </group>
                        <group>
                            <field name="product_status" widget="badge"/>
                            <field name="inventory_status" widget="badge"/>
                            <field name="last_product_published_at"/>
                            <field name="last_inventory_published_at"/>
                        </group>
                    </group>
                    <group string="Shopify IDs">
                        <field name="shopify_product_gid"/>
                        <field name="shopify_variant_gid"/>
                        <field name="shopify_inventory_item_gid"/>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_sync_order_list" model="ir.ui.view">
        <field name="name">shopify.sync.order.list</field>
        <field name="model">shopify.sync.order</field>
        <field name="arch" type="xml">
            <list string="Shopify Orders" decoration-danger="status == 'failed'" decoration-success="status in ['confirmed', 'paid', 'fulfilled']">
                <header>
                    <button name="action_validate" string="Validate" type="object"/>
                    <button name="action_create_sale_order" string="Create Odoo Draft" type="object"/>
                    <button name="action_confirm_quotation" string="Confirm Quotation" type="object"/>
                    <button name="action_refund_failed_in_shopify" string="Refund Failed In Shopify" type="object"/>
                    <button name="action_mark_fulfilled" string="Mark Fulfilled" type="object"/>
                </header>
                <field name="order_number"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="total_amount"/>
                <field name="financial_status"/>
                <field name="fulfillment_status"/>
                <field name="status" widget="badge"
                       decoration-success="status in ['validated', 'published', 'confirmed', 'paid', 'fulfilled']"
                       decoration-warning="status == 'warning'"
                       decoration-danger="status == 'failed'"/>
                <field name="shopify_refund_status" widget="badge"
                       decoration-success="shopify_refund_status == 'submitted'"
                       decoration-danger="shopify_refund_status == 'failed'"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_sync_order_form" model="ir.ui.view">
        <field name="name">shopify.sync.order.form</field>
        <field name="model">shopify.sync.order</field>
        <field name="arch" type="xml">
            <form string="Shopify Order">
                <header>
                    <button name="action_validate" string="Validate" type="object" class="btn-secondary"/>
                    <button name="action_create_sale_order" string="Create Odoo Draft" type="object" class="btn-primary"
                            invisible="sale_order_id"/>
                    <button name="action_confirm_quotation" string="Confirm Quotation" type="object" class="btn-primary"
                            invisible="not sale_order_id or status in ['confirmed', 'fulfilled']"/>
                    <button name="action_refund_failed_in_shopify" string="Refund Failed In Shopify" type="object" class="btn-primary"
                            invisible="status != 'failed' or shopify_refund_status == 'submitted'"/>
                    <button name="action_mark_fulfilled" string="Mark Fulfilled" type="object" class="btn-primary"
                            invisible="not sale_order_id or status == 'fulfilled'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_order" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <field name="sale_order_id" widget="statinfo" string="Sale Order"/>
                        </button>
                    </div>
                    <group>
                        <group string="Shopify">
                            <field name="instance_id"/>
                            <field name="order_number"/>
                            <field name="shopify_gid"/>
                            <field name="financial_status"/>
                            <field name="fulfillment_status"/>
                            <field name="total_amount"/>
                            <field name="currency"/>
                            <field name="shopify_refund_status" widget="badge"/>
                            <field name="shopify_cancel_job_gid"/>
                            <field name="shopify_refunded_at"/>
                        </group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="country"/>
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <group string="Validation">
                        <field name="validation_message" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="title"/>
                                    <field name="sku"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="product_id"/>
                                    <field name="validation_status" widget="badge"
                                           decoration-success="validation_status == 'valid'"
                                           decoration-warning="validation_status == 'warning'"
                                           decoration-danger="validation_status == 'failed'"/>
                                    <field name="validation_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_shopify_sync_event_list" model="ir.ui.view">
        <field name="name">shopify.sync.event.list</field>
        <field name="model">shopify.sync.event</field>
        <field name="arch" type="xml">
            <list string="Shopify Sync Events" create="0" edit="0">
                <field name="create_date"/>
                <field name="instance_id"/>
                <field name="action"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-warning="status == 'warning'"
                       decoration-danger="status == 'failed'"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_shopify_sync_event_form" model="ir.ui.view">
        <field name="name">shopify.sync.event.form</field>
        <field name="model">shopify.sync.event</field>
        <field name="arch" type="xml">
            <form string="Shopify Sync Event" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="instance_id"/>
                        <field name="action"/>
                        <field name="status" widget="badge"/>
                    </group>
                    <group>
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shopify_sync_instance" model="ir.actions.act_window">
        <field name="name">Shopify Sync</field>
        <field name="res_model">shopify.sync.instance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_shopify_sync_catalog" model="ir.actions.act_window">
        <field name="name">Catalog</field>
        <field name="res_model">shopify.sync.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_shopify_sync_orders" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">shopify.sync.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_shopify_sync_events" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">shopify.sync.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shopify_sync_root" name="Shopify Sync" sequence="45" action="action_shopify_sync_instance"/>
    <menuitem id="menu_shopify_sync_dashboard" name="Dashboard" parent="menu_shopify_sync_root" action="action_shopify_sync_instance" sequence="10"/>
    <menuitem id="menu_shopify_sync_catalog" name="Catalog" parent="menu_shopify_sync_root" action="action_shopify_sync_catalog" sequence="20"/>
    <menuitem id="menu_shopify_sync_orders" name="Orders" parent="menu_shopify_sync_root" action="action_shopify_sync_orders" sequence="30"/>
    <menuitem id="menu_shopify_sync_events" name="Events" parent="menu_shopify_sync_root" action="action_shopify_sync_events" sequence="40"/>
</odoo>
