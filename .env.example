# Copy this file to .env when you want Compose to prefill the native Odoo app.
# The project is Odoo-only: there is no standalone FastAPI service, React
# dashboard, SQLite metadata store, or embedded Shopify admin app.

# Odoo container image. Keep this pinned to the version targeted by the module.
ODOO_IMAGE=odoo:19

# Shopify Admin API connection used by the Odoo module.
# Example: odoo-sync-demo-likp7ttj.myshopify.com
SHOPIFY_SHOP_DOMAIN=

# Preferred for a custom Shopify app created inside the dev store.
SHOPIFY_ACCESS_TOKEN=

# Optional fallback for Shopify dev-dashboard apps that support client credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional webhook bootstrap values. Localhost cannot receive Shopify webhooks
# directly, so use a public HTTPS tunnel URL for the callback during demos.
# Example: https://your-tunnel.example.com/shopify_sync_demo/webhooks/orders_create?db=shopify_odoo_demo
SHOPIFY_WEBHOOK_CALLBACK_URL=
SHOPIFY_WEBHOOK_SECRET=

# Keep aligned with the GraphQL mutations used by the module.
SHOPIFY_ADMIN_API_VERSION=2026-04
